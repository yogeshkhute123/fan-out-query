# Copy to .env and fill in what you have. Every provider is optional:
# anything left blank is skipped (and reported) – never simulated.
# The tool works with NO keys at all, using the free sources below.

# --- Free sources (no key / account) ---
FREE_SOURCES_ENABLED=true
AUTOCOMPLETE_ENGINES=google,bing,duckduckgo
# basic = question/preposition/commercial probes (34 per engine); full = also seed + a..z (60 per engine)
AUTOCOMPLETE_DEPTH=full
SUGGEST_DELAY=1.0
WIKIPEDIA_ENABLED=true
REDDIT_PUBLIC_ENABLED=true
# Competitor pages to analyse (comma-separated) – replaces SERP-based competitor discovery
COMPETITOR_URLS=

# --- LLM / AI-search research ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
LLM_ENABLED=true

# --- Google Ads Keyword Planner (search volume, competition, CPC) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Manager (MCC) account ID, if you access the customer through one:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional overrides when your country/language is not in the built-in table:
GOOGLE_ADS_GEO_TARGET_ID=
GOOGLE_ADS_LANGUAGE_ID=

# --- SERP provider: "serpapi" (uses SERP_API_KEY) or "serper" (uses SERPER_API_KEY) ---
SERP_PROVIDER=serpapi
SERP_API_KEY=
SERPER_API_KEY=
MAX_SERP_QUERIES=14
MAX_COMPETITOR_PAGES=8

# --- Reddit official API (script app, read-only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=seo-fanout-research/1.0 by your-reddit-username

# --- Crawling ---
CRAWL_USER_AGENT=SEOFanoutResearchBot/1.0 (+responsible crawler; contact site owner)
CRAWL_DELAY=1.0
CRAWL_MAX_PAGES=300
CRAWL_TIMEOUT=20
CRAWL_MAX_RETRIES=3
CRAWL_RESPECT_ROBOTS=true

# --- Semantic similarity ---
USE_SENTENCE_TRANSFORMERS=true
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Paths (optional) ---
# FANOUT_DB_PATH=data/fanout.sqlite3
# FANOUT_OUTPUT_DIR=output
# FANOUT_LOG_DIR=logs
